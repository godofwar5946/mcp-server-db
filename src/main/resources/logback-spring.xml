<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      重要说明：
      - MCP 的 stdio 传输使用 stdout 作为协议输出通道
      - 因此在 stdio profile 下，我们把普通日志输出到 STDERR，避免破坏协议数据

      SQL 审计日志：
      - 统一走 logger：SQL_AUDIT
      - 以 JSON 行格式输出到独立文件 logs/sql-audit.log（便于后续 grep/检索/追溯）
    -->

    <!-- 日志目录：默认当前工作目录下 logs/；可通过环境变量 LOG_PATH 覆盖 -->
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>

    <!-- SQL 审计日志：滚动文件（按天 + 按大小切分；默认不设置 maxHistory，表示长期保留，注意磁盘容量） -->
    <appender name="SQL_AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/sql-audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/sql-audit.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <!-- 每条日志一行 JSON，便于机器检索与处理 -->
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- 将 SQL_AUDIT logger 绑定到独立文件，避免与业务日志混杂 -->
    <logger name="SQL_AUDIT" level="INFO" additivity="false">
        <appender-ref ref="SQL_AUDIT_FILE"/>
    </logger>

    <springProfile name="stdio">
        <appender name="CONSOLE_ERR" class="ch.qos.logback.core.ConsoleAppender">
            <target>System.err</target>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_ERR"/>
        </root>
    </springProfile>

    <springProfile name="!stdio">
        <appender name="CONSOLE_OUT" class="ch.qos.logback.core.ConsoleAppender">
            <target>System.out</target>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_OUT"/>
        </root>
    </springProfile>
</configuration>

